# ---------------------------------------------------------------- secrets
# Anything under ANY secrets/ directory, at any depth. The leading **/ matters:
# a bare "secrets/*.json" is anchored to this file's directory and would NOT
# have matched dist/AutoStream/secrets/token.json, which the build copies there.
**/secrets/*
!secrets/.gitkeep

# config.yaml holds the OBS websocket password, the YouTube stream key and the
# local web token. config.example.yaml is the tracked template instead.
**/config/config.yaml
**/config/apps.yaml
*.bak
*.orig

# ---------------------------------------------------------------- runtime
**/logs/
**/state.json
**/config/index.cache.json
NOSTREAM

# The session journal is personal history: broadcast ids, watch URLs, what was
# played and when.
**/history.jsonl

# Clip output. Gigabytes of video, and it is all reproducible from the
# recording it came from.
/clips/

# Kill-marker profiles the user calibrated on their own footage, and the
# template patches that go with them -- each one is a crop of somebody's own
# recording, and the repo is public.
#
# The shipped profiles live in clips/profiles.py:BUILTIN and their templates in
# autostream/clips/templates/, which IS tracked. config/clip_templates/ is
# where calibration writes, and holds nothing else -- an earlier version of
# this comment said the shipped template lived there too, which was wrong: git
# has never tracked a file under it, so every .npy the calibrator wrote there
# showed up as a new untracked file waiting to be committed by accident.
**/config/clip_profiles.yaml
**/config/clip_templates/

# ---------------------------------------------------------------- build
build/
dist/
*.egg-info/

# ---------------------------------------------------------------- python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# ---------------------------------------------------------------- editors / OS
.vscode/
.idea/
Thumbs.db
Desktop.ini

# Claude Code local permission grants - machine specific, never shared
.claude/settings.local.json
